# Supabase-Zugangsdaten deines Lumo-Projekts
# (Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Registrierung in der App zeigen (Standard: aus). Nur lokal/zum Testen auf true setzen.
# VITE_ALLOW_SIGNUP=true
# Domain für Benutzernamen-Konten (testuser → testuser@<Domain>)
# VITE_USERNAME_DOMAIN=user.lumo.berendak.ch
